SPACE_ID=1
THRESHOLD_PROFILE=demo            # report | demo
FLASK_HOST=0.0.0.0
FLASK_PORT=5000
MQTT_BROKER_URL=tcp://localhost:1883
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_TLS=false
CAMERA_STREAM_URL=http://192.168.1.50:81/stream
PERSON_DETECTOR=mock              # mock | real
FACE_RECOGNIZER=mock              # mock | real
CAMERA_FPS=3                      # cuadros inferidos por segundo (2-5)
PERSON_MODEL_PATH=                # opcional; por defecto edge/data/models/object_detection_yolox_2022nov.onnx
FACE_DETECTOR_MODEL_PATH=         # opcional; por defecto edge/data/models/face_detection_yunet_2023mar.onnx
FACE_RECOGNIZER_MODEL_PATH=       # opcional; por defecto edge/data/models/face_recognition_sface_2021dec.onnx
KNOWN_FACES_DIR=                  # opcional; por defecto edge/data/known_faces (ver docs/vision.md)
SOUND_TRIGGERS_REQUIRED=1
SOUND_WINDOW_SECONDS=3
LOCK_ENERGIZE_TO_UNLOCK=true
LOCK_PULSE_SECONDS=3
ENABLE_SIMULATION=true
RETENTION_DAYS=7
EVIDENCE_DIR=                     # opcional; por defecto edge/data/evidence
