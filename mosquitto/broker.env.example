# Copiar a mosquitto/broker.env (ignorado por git) y cambiar las contrasenas.
# Sin espacios ni comillas alrededor del "=".

# Usuario del edge (va en el .env del edge: MQTT_USERNAME / MQTT_PASSWORD)
EDGE_MQTT_USERNAME=sentrya-edge
EDGE_MQTT_PASSWORD=cambiar-esta-clave

# Usuario de IoT Monitoring (Go)
MONITORING_MQTT_USERNAME=iot-monitoring
MONITORING_MQTT_PASSWORD=cambiar-esta-otra-clave
